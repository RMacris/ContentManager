{
  "manifest_version": 3,
  "name": "Bloqueador de HTTP e Sites",
  "version": "1.10.1",
  "description": "Bloqueie sites indesejados, esconda vídeos antigos, jogos e anúncios no YouTube e colete feed e inscrições.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "icons": {
    "16": "icons/icons16.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/block-guard.js"]
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content/age-core.js", "src/content/age-filter.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
