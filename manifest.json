{
  "manifest_version": 3,
  "name": "Bloqueador de HTTP e Sites",
  "version": "2.5.1",
  "description": "Bloqueie sites, esconda vídeos antigos, jogos e anúncios e filtre títulos e canais no YouTube, com allowlist.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "icons": {
    "16": "icons/icons16.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/block-guard.js"]
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content/age-core.js", "src/content/keyword-core.js", "src/content/channel-rules.js", "src/content/youtube-dom.js", "src/content/content-runtime.js", "src/content/channel-button.js", "src/content/age-filter.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
